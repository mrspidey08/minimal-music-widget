<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MINIMAL MUSIC"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4:1 Modern Sharp Widget"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Live Widget Preview Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE WIDGET PREVIEW"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#161616"
            android:padding="2dp">

            <!-- Inclusion of actual widget layout for live preview -->
            <include
                android:id="@+id/preview_widget"
                layout="@layout/widget_music_control" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap controls above to test playback directly."
            android:textColor="#666666"
            android:textSize="11sp"
            android:layout_marginTop="6dp" />

        <!-- Widget Heading Settings (Song Title vs Custom Text Toggle) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WIDGET HEADING SETTINGS"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121212"
            android:padding="16dp">

            <!-- Toggle Row: Song Title vs Custom Text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display Song Title"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_toggle_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show title of currently playing song"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_song_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Custom Text Sub-Section (editable anytime, active when toggle is OFF) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#222222"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:id="@+id/layout_custom_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_custom_text_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom Heading Text"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_header_text"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#1E1E1E"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:hint="MUSIC IS LIFE"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_save_text"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="SAVE CUSTOM TEXT"
                    android:textColor="#000000"
                    android:background="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Media Access Permission Status Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDIA SESSION CONTROL ACCESS"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121212"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_permission_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Checking access..."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS"
                    android:textColor="#000000"
                    android:background="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_permission_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Required to read real-time song titles and directly control active players (Spotify, YouTube Music, Apple Music, etc.)."
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/btn_grant_permission"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="GRANT NOTIFICATION ACCESS"
                android:textColor="#000000"
                android:background="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- Quick Instructions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOW TO ADD TO HOME SCREEN"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121212"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Return to your Android Home screen.\n2. Long-press any empty space and tap 'Widgets'.\n3. Scroll to 'Minimal Music Widget'.\n4. Touch and hold the 4:1 widget to place it on your screen."
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:lineSpacingExtra="6dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
